{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "basement-ready",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "basement-ready-phone",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev:phone"
      ],
      "port": 5173,
      "url": "https://localhost:5173"
    },
    {
      "name": "basement-ready-alt-ports",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "exec",
        "concurrently",
        "-k",
        "-n",
        "api,web",
        "API_PORT=8823 tsx watch server/index.ts",
        "API_PORT=8823 vite --port 5193 --strictPort"
      ],
      "port": 5193
    }
  ]
}
