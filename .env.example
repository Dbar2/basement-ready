# Meta Model API key from https://dev.meta.ai/api-keys/
MODEL_API_KEY=

# The 3D service (services/scan3d). Locally `pnpm dev` points at the Mac runner on port 8790; in
# production, the Modal web endpoint `modal deploy` prints, and the token stored in the Modal secret
# `scan3d-token`. Without these the scan runs without 3D.
SCAN3D_URL=
SCAN3D_TOKEN=
# Areas measured side by side: 1 on the Mac, 3 on Modal (app.py max_containers).
SCAN3D_PARALLEL=1
