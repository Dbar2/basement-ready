{
  "name": "basement-ready",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Film your basement and find out if it can become a second home.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:web": "vite",
    "dev:api": "API_PORT=8787 tsx watch --env-file=.env server/index.ts",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "test:meta": "tsx --env-file=.env scripts/test-meta.ts",
    "typecheck": "tsc -b",
    "make:sample": "tsx scripts/make-sample.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "hono": "^4.13.14",
    "motion": "^14.7.1",
    "openai": "^7.45.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
